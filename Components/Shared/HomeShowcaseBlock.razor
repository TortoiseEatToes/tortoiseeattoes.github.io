<MudPaper Class="d-flex flex-grow-1">
	<MudStack Class="d-flex flex-grow-1 ma-5">
		<MudText Typo="Typo.h5" style="text-align: center;">@Title</MudText>
		<div class="center">
			@ChildContent
		</div>
		<MudStack Class="d-flex">
			<MudText><b>Date Range:</b> @DateRange</MudText>
			<MudText><b>Platforms:</b> @Platforms</MudText>
			<MudText><b>Tools:</b> @Tools</MudText>
			@if (!string.IsNullOrEmpty(ProjectPageName))
			{
				<MudButton Href=@GetProjectHref() Variant=Variant.Filled Color=Color.Primary>Read More</MudButton>
			}
		</MudStack>
	</MudStack>
</MudPaper>

@code {
	[Parameter]
	public string Title { get; set; } = "Title not set";

	[Parameter]
	public string DateRange { get; set; } = "";

	[Parameter]
	public string Tools { get; set; } = "";

	[Parameter]
	public string Platforms { get; set; } = "";

	[Parameter]
	public string ProjectPageName { get; set; } = "";

	[Parameter]
	public RenderFragment? ChildContent { get; set; }

	private string GetProjectHref()
	{
		return $"/projects/{ProjectPageName}";
	}
}
